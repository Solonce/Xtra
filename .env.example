# Create an app at https://developer.spotify.com/dashboard and add
#   http://127.0.0.1:3000/api/auth/callback
# as a Redirect URI (Spotify no longer accepts "localhost").
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Public URL of the app, no trailing slash.
APP_URL=http://127.0.0.1:3000

# Any long random string: `openssl rand -base64 32`
SESSION_SECRET=

# Local SQLite file by default. For deployment use a Turso/libSQL URL + token.
DATABASE_URL=file:xtra.db
DATABASE_AUTH_TOKEN=

# Shared secret for GET /api/cron/sync (sent as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=
